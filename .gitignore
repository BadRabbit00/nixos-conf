# Ignore build outputs from performing a nix-build or `nix build` command
result
result-*

# Ignore automatically generated direnv output
.direnv

# VM disk images
*.qcow2
*.vmdk

# Local reference material (upstream assets, not tracked)
ref/

#env
*.env
.env

# age-ключ sops (НИКОГДА не коммитить)
.key

# Local analysis, test caches, editor backups and build logs
graphify-out/
.graphify-*/
__pycache__/
.pytest_cache/
*.log
*.swp
*.swo
*~
*.backup
# Local credentials (encrypted modules/core/secrets/secrets.yaml stays tracked)
*.agekey
keys.txt
